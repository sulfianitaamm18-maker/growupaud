rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function existsUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return existsUserData() ? getUserData().role : '';
    }

    function getUserSchoolId() {
      return existsUserData() ? getUserData().schoolId : '';
    }

    function isUserActive() {
      return existsUserData() && getUserData().isActive == true;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isAuthenticated() && isUserActive() && (
        getUserRole() == 'SUPER_ADMIN'
      );
    }

    function isAdmin() {
      return isAuthenticated() && isUserActive() && (
        getUserRole() == 'ADMIN' ||
        getUserRole() == 'SUPER_ADMIN'
      );
    }

    function isOperator() {
      return isAuthenticated() && isUserActive() && getUserRole() == 'OPERATOR';
    }

    function isPrincipal() {
      return isAuthenticated() && isUserActive() && (
        getUserRole() == 'PRINCIPAL' || 
        getUserRole() == 'KEPALA_SEKOLAH'
      );
    }

    function isTeacher() {
      return isAuthenticated() && isUserActive() && (
        getUserRole() == 'TEACHER' || 
        getUserRole() == 'GURU'
      );
    }

    function isParent() {
      return isAuthenticated() && isUserActive() && (
        getUserRole() == 'PARENT' || 
        getUserRole() == 'ORANG_TUA'
      );
    }

    function getUserClassId() {
      return existsUserData() && ('classId' in getUserData()) ? getUserData().classId : '';
    }

    function getUserClassName() {
      return existsUserData() && ('className' in getUserData()) ? getUserData().className : '';
    }

    function isTeacherAssignedToStudent(studentData) {
      return isTeacher() && studentData.schoolId == getUserSchoolId();
    }

    function isParentOfStudent(studentData) {
      return isParent() && (
        ('parentIds' in studentData && studentData.parentIds is list && request.auth.uid in studentData.parentIds) ||
        ('parentId' in studentData && studentData.parentId == request.auth.uid)
      );
    }

    // Collection 1: users/{userId}
    match /users/{userId} {
      // 1. Owner can read their own profile directly (NO recursive get() or helper calls)
      allow read: if request.auth != null && request.auth.uid == userId;

      // 2. Admin/Principal/Operator in the SAME school (or SuperAdmin) can read profiles in their school
      allow read: if request.auth != null && (
        ((isAdmin() || isOperator() || isPrincipal()) && resource.data.schoolId == getUserSchoolId()) ||
        isSuperAdmin()
      );

      // 3. User creation: privileged profiles are server-provisioned only.
      allow create: if ((isAdmin() || isOperator()) && request.resource.data.schoolId == getUserSchoolId()) || isSuperAdmin();

      // 4. User update:
      // - Admin can update users in their school AND cannot move them to another school
      // - Regular user can update their own profile EXCEPT role, schoolId, isActive, studentIds, linkedStudentIds, childId, parentIds
      allow update: if (
        isAdmin() &&
        resource.data.schoolId == getUserSchoolId() &&
        request.resource.data.schoolId == getUserSchoolId()
      ) || 
      isSuperAdmin() || 
      (
        request.auth != null && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'schoolId', 'isActive', 'studentIds', 'linkedStudentIds', 'childId', 'parentIds'
        ])
      );

      // 5. User deletion: Only Admin for users in their school
      allow delete: if ((isAdmin() || isOperator()) && resource.data.schoolId == getUserSchoolId()) || isSuperAdmin();
    }

    // Collection 2: schools/{schoolId}
    match /schools/{schoolId} {
      allow read: if isAuthenticated() && (getUserSchoolId() == schoolId || isSuperAdmin());
      allow write: if ((isAdmin() || isOperator()) && getUserSchoolId() == schoolId) || isSuperAdmin();
    }

    // Collection 3: classes/{classId}
    match /classes/{classId} {
      // Read access: Admin, Principal, Operator in same school, or Teacher assigned to that class
      allow read: if isAuthenticated() && isUserActive() && (
        ((isAdmin() || isOperator() || isPrincipal()) && resource.data.schoolId == getUserSchoolId()) ||
        (isTeacher() && resource.data.schoolId == getUserSchoolId() && (
          resource.data.teacherId == request.auth.uid ||
          ('teacherIds' in resource.data && resource.data.teacherIds is list && request.auth.uid in resource.data.teacherIds) ||
          getUserClassId() == classId ||
          (getUserClassName() != '' && 'name' in resource.data && getUserClassName() == resource.data.name)
        )) ||
        isSuperAdmin()
      );

      // Create access: Admin in the same school
      allow create: if ((isAdmin() || isOperator()) && request.resource.data.schoolId == getUserSchoolId()) || isSuperAdmin();

      // Update access: Admin in the same school (cannot change schoolId)
      allow update: if (
        (isAdmin() || isOperator()) &&
        resource.data.schoolId == getUserSchoolId() &&
        request.resource.data.schoolId == getUserSchoolId()
      ) || isSuperAdmin();

      // Delete access: Admin in the same school
      allow delete: if ((isAdmin() || isOperator()) && resource.data.schoolId == getUserSchoolId()) || isSuperAdmin();
    }

    // Collection 4: students/{studentId}
    match /students/{studentId} {
      // Read access:
      // - Parent: direct match on parentIds list or legacy parentId without blocking collection queries
      // - Admin / Principal / Operator: read students in same school (or SuperAdmin)
      // - Teacher: ONLY read students strictly assigned to them (via teacherIds, classId, or className)
      allow read: if isAuthenticated() && (
        ('parentIds' in resource.data && resource.data.parentIds is list && request.auth.uid in resource.data.parentIds) ||
        ('parentId' in resource.data && resource.data.parentId == request.auth.uid) ||
        (isUserActive() && (
          ((isAdmin() || isOperator() || isPrincipal()) && (resource.data.schoolId == getUserSchoolId() || isSuperAdmin())) ||
          isTeacherAssignedToStudent(resource.data)
        ))
      );

      // Write access:
      // - ONLY Admin / Operator can create, update, or delete student master records in their school!
      // - Users and Teachers CANNOT modify student parentIds or master profiles
      allow create: if ((isAdmin() || isOperator()) && request.resource.data.schoolId == getUserSchoolId()) || isSuperAdmin();
      allow update: if (
        (isAdmin() || isOperator()) &&
        resource.data.schoolId == getUserSchoolId() &&
        request.resource.data.schoolId == getUserSchoolId()
      ) || isSuperAdmin();
      allow delete: if (isAdmin() && resource.data.schoolId == getUserSchoolId()) || isSuperAdmin();
    }

    // Collection 5: observations/{obsId}
    match /observations/{obsId} {
      // Read access:
      // - Author Teacher
      // - Parent whose child is the subject (verified via user doc linked IDs, observation parentIds, or student parentIds)
      // - School Staff (Admin, Principal, Operator, and Teachers in same school)
      allow read: if isAuthenticated() && (
        (resource.data.teacherId == request.auth.uid) ||
        (
          existsUserData() && (
            ('linkedStudentIds' in getUserData() && resource.data.studentId in getUserData().linkedStudentIds) ||
            ('studentIds' in getUserData() && resource.data.studentId in getUserData().studentIds) ||
            ('childId' in getUserData() && resource.data.studentId == getUserData().childId)
          )
        ) ||
        (
          ('parentIds' in resource.data && resource.data.parentIds is list && request.auth.uid in resource.data.parentIds) ||
          ('parentId' in resource.data && resource.data.parentId == request.auth.uid)
        ) ||
        (
          exists(/databases/$(database)/documents/students/$(resource.data.studentId)) &&
          isParentOfStudent(get(/databases/$(database)/documents/students/$(resource.data.studentId)).data)
        ) ||
        (
          isUserActive() && (
            ((isAdmin() || isOperator() || isPrincipal()) && (resource.data.schoolId == getUserSchoolId() || isSuperAdmin())) ||
            (isTeacher() && resource.data.schoolId == getUserSchoolId())
          )
        )
      );

      // Create access:
      // - Teacher: can ONLY create observation if teacherId == auth.uid AND teacher is assigned to that student
      // - Academic year must NOT be CLOSED
      // - Admin: can create in their school
      // - Principal & Parent: DENY
      allow create: if (
        (
          isAdmin() && (request.resource.data.schoolId == getUserSchoolId() || isSuperAdmin())
        ) ||
        (
          isTeacher() && 
          request.resource.data.teacherId == request.auth.uid && 
          request.resource.data.schoolId == getUserSchoolId() &&
          exists(/databases/$(database)/documents/students/$(request.resource.data.studentId)) &&
          isTeacherAssignedToStudent(get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data)
        )
      ) && (
        !('academicYearId' in request.resource.data) || 
        request.resource.data.academicYearId == '' || 
        !exists(/databases/$(database)/documents/academicYears/$(request.resource.data.academicYearId)) || 
        get(/databases/$(database)/documents/academicYears/$(request.resource.data.academicYearId)).data.status != 'CLOSED'
      );

      // Update access:
      // - Teacher: can ONLY update own observation in same school
      // - Admin: can update in same school
      // - Principal & Parent: DENY
      // - Cannot update observations belonging to a CLOSED academic year
      allow update: if (
        (
          isAdmin() && 
          resource.data.schoolId == getUserSchoolId() && 
          request.resource.data.schoolId == getUserSchoolId()
        ) || 
        isSuperAdmin() || 
        (
          isTeacher() && 
          resource.data.teacherId == request.auth.uid && 
          request.resource.data.teacherId == request.auth.uid && 
          resource.data.schoolId == getUserSchoolId() && 
          request.resource.data.schoolId == getUserSchoolId()
        )
      ) && (
        !('academicYearId' in resource.data) ||
        resource.data.academicYearId == '' ||
        !exists(/databases/$(database)/documents/academicYears/$(resource.data.academicYearId)) ||
        get(/databases/$(database)/documents/academicYears/$(resource.data.academicYearId)).data.status != 'CLOSED'
      );

      // Delete access:
      // - Teacher: can delete own observation in same school
      // - Admin: can delete in same school
      // - Principal & Parent: DENY
      // - Cannot delete observations belonging to a CLOSED academic year
      allow delete: if (
        (isAdmin() && resource.data.schoolId == getUserSchoolId()) ||
        isSuperAdmin() ||
        (
          isTeacher() && 
          resource.data.teacherId == request.auth.uid && 
          resource.data.schoolId == getUserSchoolId()
        )
      ) && (
        !('academicYearId' in resource.data) ||
        resource.data.academicYearId == '' ||
        !exists(/databases/$(database)/documents/academicYears/$(resource.data.academicYearId)) ||
        get(/databases/$(database)/documents/academicYears/$(resource.data.academicYearId)).data.status != 'CLOSED'
      );
    }

    // Collection 6: feedbacks/{feedbackId}
    match /feedbacks/{feedbackId} {
      // Read access:
      // - Parent: can read their own feedbacks directly
      // - Admin / Principal / Operator: can read feedbacks in their school
      // - Teacher: can ONLY read feedback for students assigned to them in same school
      allow read: if isAuthenticated() && (
        (resource.data.parentId == request.auth.uid) ||
        ('parentIds' in resource.data && resource.data.parentIds is list && request.auth.uid in resource.data.parentIds) ||
        (isUserActive() && (
          ((isAdmin() || isOperator() || isPrincipal()) && resource.data.schoolId == getUserSchoolId()) ||
          isSuperAdmin() ||
          (
            isTeacher() &&
            resource.data.schoolId == getUserSchoolId() &&
            (
              ('teacherId' in resource.data && resource.data.teacherId == request.auth.uid) ||
              ('teacherIds' in resource.data && resource.data.teacherIds is list && request.auth.uid in resource.data.teacherIds) ||
              ('classId' in resource.data && getUserClassId() != '' && resource.data.classId == getUserClassId()) ||
              (
                exists(/databases/$(database)/documents/students/$(resource.data.studentId)) &&
                isTeacherAssignedToStudent(get(/databases/$(database)/documents/students/$(resource.data.studentId)).data)
              )
            )
          )
        ))
      );

      // Create access:
      // - Parent can ONLY create feedback for their legitimate child (student.parentIds includes auth.uid)
      // - Teacher / Admin can create
      allow create: if isAuthenticated() && isUserActive() && (
        (
          isParent() &&
          request.resource.data.parentId == request.auth.uid &&
          request.resource.data.schoolId == getUserSchoolId() &&
          exists(/databases/$(database)/documents/students/$(request.resource.data.studentId)) &&
          isParentOfStudent(get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data)
        ) ||
        (
          isTeacher() &&
          request.resource.data.schoolId == getUserSchoolId() &&
          exists(/databases/$(database)/documents/students/$(request.resource.data.studentId)) &&
          isTeacherAssignedToStudent(get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data)
        ) ||
        (isAdmin() && (request.resource.data.schoolId == getUserSchoolId() || isSuperAdmin()))
      );

      // Update access:
      // - Teacher can only reply/update for assigned student
      // - Admin can update in same school
      // - Parent: DENY update (feedback is immutable once sent)
      allow update: if isAuthenticated() && isUserActive() && (
        (
          isTeacher() &&
          resource.data.schoolId == getUserSchoolId() &&
          (
            ('teacherId' in resource.data && resource.data.teacherId == request.auth.uid) ||
            ('teacherIds' in resource.data && resource.data.teacherIds is list && request.auth.uid in resource.data.teacherIds) ||
            (
              exists(/databases/$(database)/documents/students/$(resource.data.studentId)) &&
              isTeacherAssignedToStudent(get(/databases/$(database)/documents/students/$(resource.data.studentId)).data)
            )
          )
        ) ||
        ((isAdmin() || isPrincipal()) && resource.data.schoolId == getUserSchoolId()) ||
        isSuperAdmin()
      );

      // Delete access:
      allow delete: if isAuthenticated() && isUserActive() && (
        (isAdmin() && resource.data.schoolId == getUserSchoolId()) || isSuperAdmin()
      );
    }

    // Collection 7: academicYears/{yearId}
    match /academicYears/{yearId} {
      // Read: Any active user in the same school (Admin, Principal, Teacher, Parent) or SuperAdmin
      allow read: if isAuthenticated() && isUserActive() && (
        resource.data.schoolId == getUserSchoolId() || isSuperAdmin()
      );

      // Write: Only Admin / Operator in the same school
      allow create: if ((isAdmin() || isOperator()) && request.resource.data.schoolId == getUserSchoolId()) || isSuperAdmin();
      allow update: if (
        (isAdmin() || isOperator()) &&
        resource.data.schoolId == getUserSchoolId() &&
        request.resource.data.schoolId == getUserSchoolId()
      ) || isSuperAdmin();
      allow delete: if (isAdmin() && resource.data.schoolId == getUserSchoolId()) || isSuperAdmin();
    }

    // Collection 8: enrollments/{enrollmentId}
    match /enrollments/{enrollmentId} {
      // Read access:
      // - Admin / Principal / Operator: same school
      // - Teacher: if teacher is assigned to student or class or in teacherIds
      // - Parent: if parent is legitimate parent of the student
      allow read: if isAuthenticated() && isUserActive() && (
        ((isAdmin() || isOperator() || isPrincipal()) && (resource.data.schoolId == getUserSchoolId() || isSuperAdmin())) ||
        (
          isTeacher() && resource.data.schoolId == getUserSchoolId() && (
            ('teacherIds' in resource.data && resource.data.teacherIds is list && request.auth.uid in resource.data.teacherIds) ||
            ('classId' in resource.data && getUserClassId() != '' && resource.data.classId == getUserClassId()) ||
            (
              exists(/databases/$(database)/documents/students/$(resource.data.studentId)) &&
              isTeacherAssignedToStudent(get(/databases/$(database)/documents/students/$(resource.data.studentId)).data)
            )
          )
        ) ||
        (
          isParent() && (
            ('parentIds' in resource.data && resource.data.parentIds is list && request.auth.uid in resource.data.parentIds) ||
            (
              exists(/databases/$(database)/documents/students/$(resource.data.studentId)) &&
              isParentOfStudent(get(/databases/$(database)/documents/students/$(resource.data.studentId)).data)
            )
          )
        )
      );

      // Write access: Admin and Operator in same school only
      allow create: if ((isAdmin() || isOperator()) && request.resource.data.schoolId == getUserSchoolId()) || isSuperAdmin();
      allow update: if (
        (isAdmin() || isOperator()) &&
        resource.data.schoolId == getUserSchoolId() &&
        request.resource.data.schoolId == getUserSchoolId()
      ) || isSuperAdmin();
      allow delete: if (isAdmin() && resource.data.schoolId == getUserSchoolId()) || isSuperAdmin();
    }

    // Collection 9: semesterReports/{reportId}
    match /semesterReports/{reportId} {
      // Read access:
      // - Admin / Principal / Operator: read in same school
      // - Teacher: read if assigned to student or created report
      // - Parent: read ONLY if report status == FINAL and user is parent of student
      allow read: if isAuthenticated() && isUserActive() && (
        ((isAdmin() || isOperator() || isPrincipal()) && (resource.data.schoolId == getUserSchoolId() || isSuperAdmin())) ||
        (
          isTeacher() && resource.data.schoolId == getUserSchoolId() && (
            resource.data.teacherId == request.auth.uid ||
            (
              exists(/databases/$(database)/documents/students/$(resource.data.studentId)) &&
              isTeacherAssignedToStudent(get(/databases/$(database)/documents/students/$(resource.data.studentId)).data)
            )
          )
        ) ||
        (
          isParent() && resource.data.status == 'FINAL' && (
            exists(/databases/$(database)/documents/students/$(resource.data.studentId)) &&
            isParentOfStudent(get(/databases/$(database)/documents/students/$(resource.data.studentId)).data)
          )
        )
      );

      // Create access: Teacher assigned to student, or Admin in same school
      allow create: if isAuthenticated() && isUserActive() && (
        ((isAdmin() || isOperator()) && (request.resource.data.schoolId == getUserSchoolId() || isSuperAdmin())) ||
        (
          isTeacher() && request.resource.data.schoolId == getUserSchoolId() &&
          exists(/databases/$(database)/documents/students/$(request.resource.data.studentId)) &&
          isTeacherAssignedToStudent(get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data)
        )
      );

      // Update access:
      // - Admin can update anytime
      // - Teacher can update if not FINAL or moving to FINAL, and assigned to student
      allow update: if isAuthenticated() && isUserActive() && (
        (isAdmin() && resource.data.schoolId == getUserSchoolId()) || isSuperAdmin() ||
        (
          isTeacher() && resource.data.schoolId == getUserSchoolId() &&
          (resource.data.status != 'FINAL' || request.resource.data.status == 'FINAL') &&
          exists(/databases/$(database)/documents/students/$(resource.data.studentId)) &&
          isTeacherAssignedToStudent(get(/databases/$(database)/documents/students/$(resource.data.studentId)).data)
        )
      );

      // Delete access: Admin only
      allow delete: if (isAdmin() && resource.data.schoolId == getUserSchoolId()) || isSuperAdmin();
    }

    // Collection 10: annualReports/{reportId}
    match /annualReports/{reportId} {
      // Read access:
      // - Admin / Principal: read in same school
      // - Teacher: read if assigned to student
      // - Parent: read ONLY if isFinal == true and is parent of student
      allow read: if isAuthenticated() && isUserActive() && (
        ((isAdmin() || isOperator() || isPrincipal()) && (resource.data.schoolId == getUserSchoolId() || isSuperAdmin())) ||
        (
          isTeacher() && resource.data.schoolId == getUserSchoolId() &&
          exists(/databases/$(database)/documents/students/$(resource.data.studentId)) &&
          isTeacherAssignedToStudent(get(/databases/$(database)/documents/students/$(resource.data.studentId)).data)
        ) ||
        (
          isParent() && resource.data.isFinal == true &&
          exists(/databases/$(database)/documents/students/$(resource.data.studentId)) &&
          isParentOfStudent(get(/databases/$(database)/documents/students/$(resource.data.studentId)).data)
        )
      );

      // Create / Update access: Admin or Principal in same school, or Teacher assigned to student
      allow create: if isAuthenticated() && isUserActive() && (
        ((isAdmin() || isPrincipal()) && (request.resource.data.schoolId == getUserSchoolId() || isSuperAdmin())) ||
        (
          isTeacher() && request.resource.data.schoolId == getUserSchoolId() &&
          exists(/databases/$(database)/documents/students/$(request.resource.data.studentId)) &&
          isTeacherAssignedToStudent(get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data)
        )
      );

      allow update: if isAuthenticated() && isUserActive() && (
        isSuperAdmin() ||
        (
          resource.data.isFinal != true &&
          (
            ((isAdmin() || isPrincipal()) && resource.data.schoolId == getUserSchoolId()) ||
            (
              isTeacher() && resource.data.schoolId == getUserSchoolId() &&
              exists(/databases/$(database)/documents/students/$(resource.data.studentId)) &&
              isTeacherAssignedToStudent(get(/databases/$(database)/documents/students/$(resource.data.studentId)).data)
            )
          )
        )
      );

      // Delete access: Admin only, and ONLY if not FINAL (unless SuperAdmin)
      allow delete: if isSuperAdmin() || (
        isAdmin() &&
        resource.data.schoolId == getUserSchoolId() &&
        resource.data.isFinal != true
      );
    }

    // Collection 11: auditLogs/{logId}
    match /auditLogs/{logId} {
      // Read access: Admin and Principal in the same school (or SuperAdmin)
      allow read: if isAuthenticated() && isUserActive() && (
        ((isAdmin() || isPrincipal()) && (resource.data.schoolId == getUserSchoolId() || isSuperAdmin()))
      );

      // Create access: Authenticated user in the same school (append-only)
      allow create: if isAuthenticated() && isUserActive() && (
        request.resource.data.schoolId == getUserSchoolId() || isSuperAdmin()
      );

      // Update / Delete: DENY (Audit logs are immutable append-only)
      allow update, delete: if false;
    }

    // Collection 12: conversations/{conversationId}
    match /conversations/{conversationId} {
      // 1. Any participant can read their own conversations
      allow read: if request.auth != null && (
        request.auth.uid in resource.data.participantIds ||
        resource.data.participantIds.hasAny([request.auth.uid])
      );

      // 2. Admin / Principal in the same school can read conversations
      allow read: if request.auth != null && isUserActive() && (
        ((isAdmin() || isPrincipal()) && (resource.data.schoolId == getUserSchoolId() || isSuperAdmin()))
      );

      // Create: Authenticated participant in the same school
      allow create: if request.auth != null && (
        (request.auth.uid in request.resource.data.participantIds || request.resource.data.participantIds.hasAny([request.auth.uid])) &&
        (request.resource.data.schoolId == getUserSchoolId() || isSuperAdmin() || isUserActive())
      );

      // Update: Participants can update (e.g. lastMessage, unread count)
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.participantIds ||
        resource.data.participantIds.hasAny([request.auth.uid]) ||
        (isUserActive() && ((isAdmin() || isPrincipal()) && resource.data.schoolId == getUserSchoolId()))
      );

      // Delete: Only Admin
      allow delete: if request.auth != null && isUserActive() && (
        (isAdmin() && resource.data.schoolId == getUserSchoolId()) || isSuperAdmin()
      );

      // Subcollection: conversations/{conversationId}/messages/{messageId}
      match /messages/{messageId} {
        allow read: if request.auth != null && (
          request.auth.uid in resource.data.participantIds ||
          resource.data.participantIds.hasAny([request.auth.uid]) ||
          resource.data.senderId == request.auth.uid ||
          resource.data.recipientId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds ||
          (isUserActive() && ((isAdmin() || isPrincipal()) && (get(/databases/$(database)/documents/conversations/$(conversationId)).data.schoolId == getUserSchoolId() || isSuperAdmin())))
        );

        allow create: if request.auth != null && (
          request.resource.data.senderId == request.auth.uid
        );

        allow update: if request.auth != null && (
          request.auth.uid in resource.data.participantIds ||
          resource.data.participantIds.hasAny([request.auth.uid]) ||
          resource.data.recipientId == request.auth.uid
        );

        allow delete: if false;
      }
    }

    // Direct Collection: messages/{messageId} (for root query compatibility)
    match /messages/{messageId} {
      allow read: if request.auth != null && (
        request.auth.uid in resource.data.participantIds ||
        resource.data.participantIds.hasAny([request.auth.uid]) ||
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid ||
        (isUserActive() && ((isAdmin() || isPrincipal()) && (resource.data.schoolId == getUserSchoolId() || isSuperAdmin())))
      );

      allow create: if request.auth != null && (
        request.resource.data.senderId == request.auth.uid
      );

      allow update: if request.auth != null && (
        request.auth.uid in resource.data.participantIds ||
        resource.data.recipientId == request.auth.uid
      );

      allow delete: if false;
    }

    // Collection 13: notifications/{notificationId}
    match /notifications/{notificationId} {
      // 1. Direct recipient by userId
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;

      // 2. Direct recipient by recipientId
      allow read: if request.auth != null && resource.data.recipientId == request.auth.uid;

      // 3. SuperAdmin
      allow read: if request.auth != null && isUserActive() && isSuperAdmin();

      // Update: User can mark as read
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );

      allow create: if request.auth != null;

      allow delete: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid ||
        (isUserActive() && (isAdmin() || isSuperAdmin()))
      );
    }

    // Default Deny for all unlisted collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
